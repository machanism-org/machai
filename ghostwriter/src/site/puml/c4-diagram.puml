' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()

title Ghostwriter - C4 Component Diagram

Person(user, "User", "Runs Ghostwriter in Guidance or Act mode to process project files and workflows.")
System_Ext(projectFiles, "Project File System", "Source, test, documentation, configuration, act files, and generated files.")
System_Ext(remoteResources, "Remote Resources", "HTTP/HTTPS content, remote act definitions, and referenced prompt files.")
System_Ext(genaiProvider, "GenAI Provider", "External model service that receives prompts and executes enabled tools.")

System_Boundary(ghostwriter, "Ghostwriter") {
  Component(cli, "Command-line Entry Point", "Ghostwriter", "Parses options, loads configuration, selects Guidance or Act mode, and starts processing.")
  Component(fileProcessor, "File Processing Core", "AbstractFileProcessor", "Traverses projects and modules, applies path matching and exclusions, and invokes file or folder processing.")
  Component(aiProcessor, "AI Processing", "AIFileProcessor", "Builds prompt context, resolves includes and substitutions, configures providers and tools, and performs requests.")
  Component(guidanceProcessor, "Guidance Processing", "GuidanceProcessor", "Extracts @guidance directives and dispatches supported files to format-specific reviewers.")
  Component(actProcessor, "Act Processing", "ActProcessor / Episodes", "Loads TOML acts, merges inherited definitions, selects episodes, and executes prompts.")
  Component(reviewers, "File Reviewers", "Reviewer implementations", "Handles Java, Markdown, PUML, HTML, Python, TypeScript, and text guidance formats.")

  Component(fileTools, "File Tools", "FileFunctionTools", "Reads, writes, patches, and lists project files and directories.")
  Component(commandTools, "Command Tools", "CommandFunctionTools", "Runs security-checked commands and exposes command logs and task termination.")
  Component(webTools, "Web Tools", "WebFunctionTools", "Fetches web content, reads file resources, and calls REST APIs.")
  Component(actTools, "Act Tools", "ActFunctionTools / ActSpecFunctionTools", "Loads act details, starts acts, and retrieves asynchronous act results.")
  Component(guidanceTools, "Guidance Tools", "GuidanceFunctionTools", "Processes guidance-tagged files and folders through host operations.")
  Component(contextTools, "Project Context", "ProjectContextFunctionTools", "Stores and retrieves project-scoped variables shared by act episodes.")

  Component(providerManagement, "Provider Management", "GenaiProviderManager", "Creates the configured GenAI provider and tracks provider usage.")
  Component(toolLoading, "Tool Registration", "FunctionToolsLoader", "Registers built-in host tools and applies enabled-tool configuration to a provider.")
  Component(configuration, "Runtime Configuration", "PropertiesConfigurator / Configurator", "Resolves project, model, instructions, acts, excludes, and runtime settings.")
}

Rel(user, cli, "Invokes", "CLI")
Rel(cli, configuration, "Loads")
Rel(cli, guidanceProcessor, "Starts Guidance mode")
Rel(cli, actProcessor, "Starts Act mode")

Rel(guidanceProcessor, fileProcessor, "Uses scanning lifecycle")
Rel(actProcessor, fileProcessor, "Uses scanning lifecycle")
Rel(guidanceProcessor, aiProcessor, "Processes guidance with")
Rel(actProcessor, aiProcessor, "Executes episodes with")
Rel(guidanceProcessor, reviewers, "Selects by extension")
Rel(reviewers, projectFiles, "Reads guidance-bearing files")
Rel(fileProcessor, projectFiles, "Traverses and filters")
Rel(fileProcessor, configuration, "Reads scan settings")

Rel(actProcessor, projectFiles, "Reads project files and local TOML acts")
Rel(actProcessor, remoteResources, "Loads remote acts", "HTTP/HTTPS")
Rel(actProcessor, contextTools, "Shares episode context")

Rel(aiProcessor, configuration, "Reads runtime settings")
Rel(aiProcessor, projectFiles, "Reads prompts and writes captures")
Rel(aiProcessor, remoteResources, "Resolves referenced content", "HTTP/HTTPS/file://")
Rel(aiProcessor, providerManagement, "Obtains provider")
Rel(aiProcessor, toolLoading, "Configures tools")
Rel(aiProcessor, genaiProvider, "Sends prompts", "API")

Rel(toolLoading, fileTools, "Registers")
Rel(toolLoading, commandTools, "Registers")
Rel(toolLoading, webTools, "Registers")
Rel(toolLoading, actTools, "Registers")
Rel(toolLoading, guidanceTools, "Registers")
Rel(toolLoading, contextTools, "Registers")
Rel(fileTools, projectFiles, "Reads and writes")
Rel(commandTools, projectFiles, "Runs within")
Rel(webTools, remoteResources, "Fetches and calls", "HTTP/HTTPS/REST")
Rel(webTools, projectFiles, "Reads file:// resources")
Rel(actTools, actProcessor, "Loads or starts")
Rel(guidanceTools, guidanceProcessor, "Supports")
Rel(contextTools, projectFiles, "Scopes by project directory")

SHOW_LEGEND()
@enduml
