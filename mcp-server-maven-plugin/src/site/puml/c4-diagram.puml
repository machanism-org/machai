' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4 Component diagram for MCP Server Maven Plugin

Person(developer, "Build engineer", "Invokes a Maven goal and connects an MCP client to the running server")
System_Ext(maven, "Maven Runtime", "Creates the Mojo, injects project parameters, and executes the selected goal")
System_Ext(mcpConfigFile, "MCP Configuration File", "Provides the configuration path used to create the Machai properties configurator")
System_Ext(mcpClients, "MCP HTTP Clients", "Connect to the stateless or streamable MCP endpoint")
System_Ext(machaiMcpServer, "Machai MCP Server Library", "Provides MCP server implementations and configuration loading")
System_Ext(jvm, "Java Virtual Machine", "Hosts the server process and performs the requested exit")

System_Boundary(plugin, "MCP Server Maven Plugin") {
  Component(statelessMojo, "HttpStatelessServerMojo", "Maven Mojo", "Executes the stateless goal and starts an HttpStatelessMcpServer")
  Component(streamableMojo, "HttpStreamableMcpServerMojo", "Maven Mojo", "Executes the streamable goal and starts an HttpStreamableMcpServer")
  Component(abstractMojo, "AbstractMCPServerMojo", "Abstract Maven Mojo", "Applies parameter values, loads configuration, and supplies shared Maven project, directory, and port settings")
  Component(serverTools, "MCPServerTools", "FunctionTools", "Exposes stop_mcp_server to initiate delayed shutdown and record usage statistics")
}

Rel(developer, maven, "Invokes a goal")
Rel(maven, statelessMojo, "Executes stateless")
Rel(maven, streamableMojo, "Executes streamable")
Rel(statelessMojo, abstractMojo, "Extends and invokes shared setup")
Rel(streamableMojo, abstractMojo, "Extends and invokes shared setup")
Rel(abstractMojo, mcpConfigFile, "Reads configured path from")
Rel(abstractMojo, machaiMcpServer, "Loads PropertiesConfigurator through")
Rel(abstractMojo, jvm, "Sets params as system properties in")
Rel(statelessMojo, machaiMcpServer, "Creates, configures, and starts")
Rel(streamableMojo, machaiMcpServer, "Creates, configures, and starts")
Rel(statelessMojo, serverTools, "Registers configured tools")
Rel(streamableMojo, serverTools, "Registers configured tools")
Rel(mcpClients, machaiMcpServer, "Uses stateless or streamable HTTP endpoint")
Rel(mcpClients, serverTools, "Invokes stop_mcp_server")
Rel(serverTools, jvm, "Exits after delayed shutdown")

SHOW_LEGEND()
@enduml
