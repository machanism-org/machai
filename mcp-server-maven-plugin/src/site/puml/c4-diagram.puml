' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4 Component diagram for MCP Server Maven Plugin

Person(developer, "Build engineer", "Invokes a Maven goal and connects an MCP client to the running server")
System_Ext(maven, "Maven Runtime", "Creates and executes the selected plugin goal")
System_Ext(mavenProject, "Maven Project", "Supplies project name, version, base directory, and settings")
System_Ext(mcpConfigFile, "MCP Configuration File", "Defines the path to the server and tool configuration")
System_Ext(mcpClients, "MCP HTTP Clients", "Call the stateless or streamable MCP endpoint")
System_Ext(mcpLibrary, "Machai MCP Server Library", "Provides HTTP MCP server implementations, configuration loading, and tool hosting")
System_Ext(jvm, "Java Virtual Machine", "Hosts the server process and performs the requested exit")

System_Boundary(plugin, "MCP Server Maven Plugin") {
  Component(statelessMojo, "HttpStatelessServerMojo", "Maven Mojo", "Applies parameters, configures tools, and starts the stateless HTTP MCP server")
  Component(streamableMojo, "HttpStreamableMcpServerMojo", "Maven Mojo", "Applies parameters, configures tools, and starts the streamable HTTP MCP server")
  Component(abstractMojo, "AbstractMCPServerMojo", "Abstract Maven Mojo", "Owns Maven parameters, loads PropertiesConfigurator, and applies system properties")
  Component(serverTools, "MCPServerTools", "FunctionTools", "Provides the stop-mcp-server lifecycle tool, records usage, and initiates delayed JVM shutdown")
}

Rel(developer, maven, "Invokes stateless or streamable goal")
Rel(developer, mcpClients, "Uses")
Rel(maven, statelessMojo, "Executes")
Rel(maven, streamableMojo, "Executes")
Rel(statelessMojo, abstractMojo, "Inherits shared configuration")
Rel(streamableMojo, abstractMojo, "Inherits shared configuration")
Rel(abstractMojo, mavenProject, "Reads project context")
Rel(abstractMojo, mcpConfigFile, "Reads configured path")
Rel(abstractMojo, mcpLibrary, "Loads PropertiesConfigurator")
Rel(abstractMojo, jvm, "Sets configured system properties")
Rel(statelessMojo, mcpLibrary, "Creates, configures, and starts")
Rel(streamableMojo, mcpLibrary, "Creates, configures, and starts")
Rel(mcpClients, mcpLibrary, "Calls HTTP MCP endpoint")
Rel(mcpLibrary, serverTools, "Hosts configured lifecycle tool")
Rel(mcpClients, serverTools, "Invokes stop-mcp-server")
Rel(serverTools, jvm, "Exits after delayed shutdown")

SHOW_LEGEND()
@enduml
