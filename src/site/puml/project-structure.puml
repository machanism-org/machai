' @guidance:
' Design a C4 module structure diagram of the project.
@startuml project-structure
!include <C4/C4_Component>

title Machai project module structure
LAYOUT_WITH_LEGEND()

System_Ext(maven, "Maven", "Builds and runs Machai modules and plugins")
System_Ext(aiProviders, "GenAI providers", "AI, embeddings, and tool execution services")
System_Ext(mcpClients, "MCP clients", "AI assistants and MCP-compatible clients")

System_Boundary(machai, "Machai multi-module project") {
  Container_Boundary(foundations, "Foundation libraries") {
    Component(projectLayout, "project-layout", "Java library", "Conventional project-layout discovery and access")
    Component(genaiClient, "genai-client", "Java library", "Provider-neutral GenAI prompts and embeddings")
  }

  Container_Boundary(coreServices, "Core services") {
    Component(bindexCore, "bindex-core", "Java library", "Bindex metadata generation, registration, selection, and project assembly")
    Component(ghostwriter, "ghostwriter", "Java library / CLI", "Guidance-driven AI documentation and workflow engine")
    Component(mcpRuntime, "machai-mcp-server", "Java server runtime", "MCP server runtime with HTTP and STDIO transports")
  }

  Container_Boundary(buildIntegration, "Maven build integration") {
    Component(gwPlugin, "gw-maven-plugin", "Maven plugin", "Runs Ghostwriter acts in Maven builds")
    Component(bindexPlugin, "bindex-maven-plugin", "Maven plugin", "Generates Bindex metadata for projects and reactor builds")
    Component(mcpPlugin, "mcp-server-maven-plugin", "Maven plugin", "Starts a Machai MCP server from a Maven build")
  }

  Container_Boundary(serverDistributions, "Ready-to-run MCP servers") {
    Component(bindexServer, "bindex-mcp-server", "MCP server distribution", "Exposes Bindex tools over HTTP or STDIO")
    Component(gwServer, "gw-mcp-server", "MCP server distribution", "Exposes Ghostwriter and Bindex tools over HTTP or STDIO")
  }
}

Rel(maven, gwPlugin, "executes")
Rel(maven, bindexPlugin, "executes")
Rel(maven, mcpPlugin, "executes")
Rel(aiProviders, genaiClient, "provides AI and embedding APIs to", "HTTPS")
Rel(mcpClients, bindexServer, "uses tools from", "MCP / HTTP or STDIO")
Rel(mcpClients, gwServer, "uses tools from", "MCP / HTTP or STDIO")

Rel(ghostwriter, projectLayout, "uses")
Rel(ghostwriter, genaiClient, "uses")
Rel(bindexCore, genaiClient, "uses")
Rel(mcpRuntime, genaiClient, "uses")
Rel(gwPlugin, ghostwriter, "runs")
Rel(bindexPlugin, gwPlugin, "uses")
Rel(bindexPlugin, bindexCore, "generates metadata with")
Rel(mcpPlugin, mcpRuntime, "starts")
Rel(bindexServer, bindexCore, "publishes tools from")
Rel(bindexServer, mcpRuntime, "runs on")
Rel(gwServer, ghostwriter, "publishes tools from")
Rel(gwServer, bindexCore, "publishes tools from")
Rel(gwServer, mcpRuntime, "runs on")

@enduml
