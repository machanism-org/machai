' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml ProjectLayoutComponentDiagram
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title Project Layout - Component Diagram

Person(developer, "Developer / Tool Integrator", "Uses the project layout API to inspect and process project structures.")

System_Ext(projectFiles, "Project File System", "Project roots, source and test directories, documentation directories, modules, and descriptor files such as pom.xml, build.gradle, package.json, and pyproject.toml.")
System_Ext(mavenModel, "Maven Model API", "Apache Maven model classes used to represent parsed pom.xml metadata.")
System_Ext(gradleTooling, "Gradle Tooling API", "Loads a GradleProject model from a Gradle build.")
System_Ext(jsonParser, "Jackson JSON Parser", "Reads package.json workspace and project metadata.")
System_Ext(tomlParser, "Tomlj TOML Parser", "Reads pyproject.toml metadata for Python project detection.")
System_Ext(logging, "SLF4J Logging", "Logging facade used for diagnostics and temporary-directory initialization.")

Container_Boundary(projectCore, "org.machanism.machai.project") {
    Component(projectProcessor, "ProjectProcessor", "Abstract Java component", "Detects a project's layout, recursively scans reported modules, and delegates leaf-project processing to subclasses; null modules identify a leaf project.")
    Component(projectLayoutManager, "ProjectLayoutManager", "Java utility", "Selects and configures the first matching layout in Maven, Gradle, JavaScript/TypeScript, Python, then generic fallback order.")
}

Container_Boundary(layoutComponents, "org.machanism.machai.project.layout") {
    Component(projectLayout, "ProjectLayout", "Abstract Java component", "Defines the common contract for project roots, modules, source, test, and documentation roots, relative paths, directory exclusions, and the temporary working-directory path.")
    Component(defaultLayout, "DefaultProjectLayout", "Java component", "Fallback layout that discovers eligible immediate child directories as modules and provides empty source, test, and documentation collections.")
    Component(mavenLayout, "MavenProjectLayout", "Java component", "Exposes Maven modules, identifiers, parent identifiers, source roots, test roots, and documentation roots from a Maven model.")
    Component(gradleLayout, "GradleProjectLayout", "Java component", "Detects build.gradle, loads Gradle project children through the Tooling API, and exposes conventional src/main, src/test, and src/site roots.")
    Component(jsLayout, "JScriptProjectLayout", "Java component", "Reads package.json, identifies workspace modules, and exposes the JavaScript/TypeScript project identifier.")
    Component(pythonLayout, "PythonProjectLayout", "Java component", "Detects public named pyproject.toml projects, rejects private classifiers, and provides safe default source, test, and documentation collections.")
    Component(pomReader, "PomReader", "Java component", "Reads pom.xml files, substitutes known properties, carries forward licenses, and converts content into Apache Maven Model objects.")
}

Rel(developer, projectProcessor, "Starts project scanning with", "Java API")
Rel(developer, projectLayoutManager, "Requests layout detection from", "Java API")

Rel(projectProcessor, projectLayoutManager, "Detects a layout through")
Rel(projectProcessor, projectLayout, "Processes folders using the layout contract")
Rel(projectProcessor, projectProcessor, "Recursively scans each detected module")
Rel(projectLayoutManager, projectLayout, "Returns configured layout instance")
Rel(projectLayoutManager, mavenLayout, "Selects when pom.xml is present")
Rel(projectLayoutManager, gradleLayout, "Selects when build.gradle is present")
Rel(projectLayoutManager, jsLayout, "Selects when package.json is present")
Rel(projectLayoutManager, pythonLayout, "Selects when eligible pyproject.toml is present")
Rel(projectLayoutManager, defaultLayout, "Selects when no specialized layout matches")

Rel_U(defaultLayout, projectLayout, "Extends")
Rel_U(mavenLayout, projectLayout, "Extends")
Rel_U(gradleLayout, projectLayout, "Extends")
Rel_U(jsLayout, projectLayout, "Extends")
Rel_U(pythonLayout, projectLayout, "Extends")

Rel(projectLayout, projectFiles, "Lists directories and files, computes root-relative paths, and applies exclusions", "java.io.File / java.nio.file")
Rel(defaultLayout, projectFiles, "Reads child directories")
Rel(mavenLayout, pomReader, "Uses for Maven metadata")
Rel(pomReader, mavenModel, "Creates model from pom.xml")
Rel(gradleLayout, gradleTooling, "Loads GradleProject children and model")
Rel(gradleLayout, logging, "Logs Gradle model loading failures")
Rel(jsLayout, jsonParser, "Parses package.json")
Rel(pythonLayout, tomlParser, "Validates pyproject.toml during project detection")
Rel(projectProcessor, logging, "Logs module processing")
Rel(projectLayout, logging, "Logs temporary directory initialization")

SHOW_LEGEND()
@enduml
