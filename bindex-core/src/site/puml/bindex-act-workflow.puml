' @guidance:
' generate or update plantuml visualization bindex acts definition in `src/main/resources/acts/bindex.toml` and `src/main/resources/acts/bindex/java/mvn-project.toml`.
' The Act should be split on episodes.

@startuml bindex-workflow

title Bindex Act Workflow

start

partition "bindex: Project Layout Discovery" {
  :Start Bindex act;
  if (MODULES context is not empty?) then (yes)
    :Call end_task;
    stop
  else (no)
    if (Project layout is Maven?) then (yes)
      :Perform act bindex/java/mvn-project;
    else (no)
      :End task with message\n"Project layout is not supported";
      stop
    endif
  endif
}

partition "bindex/java/mvn-project Episode 1: Build Javadoc" {
  :Run Maven Javadoc build
  (iteration 1);
  note right
    command:
    mvn clean install javadoc:javadoc
      -Dshow=protected
      -DreportOutputDirectory="target/reports"
      -DdestDir="apidocs"
      -DskipTests -q
  end note
  :Verify output directory\ntarget/reports/apidocs;
  while (Errors or warnings\nand fewer than 3 attempts?) is (yes)
    :Fix Javadoc issues;
    :Run Maven Javadoc build again;
    :Verify output directory\ntarget/reports/apidocs;
  endwhile (no)
  note right
    No interactive dialogue:
    do not ask follow-up questions,
    do not request confirmation,
    do not present choices.
  end note
}

partition "bindex/java/mvn-project Episode 2: Generation and Validation" {
  :Read and analyze *.md files\nin src/site/markdown;
  :Perform act bindex/java/extract-javadoc\n(async: false);
  note right
    parameter:
    gw.path = "glob:target/reports/apidocs/**/*.html"
  end note
  :Run Maven effective POM generation;
  note right
    command:
    mvn help:effective-pom
      -Doutput=target/effective-pom.xml -q
  end note
  :Load Bindex schema;
  note right
    ${public.schemaUrl}
    (bindex-schema-v2.json)
  end note
  :Create or update bindex.json from markdown docs,
  extract-javadoc result and effective POM;
  note right
    - Strictly conform to Bindex schema
    - Populate all required fields
    - Include relevant optional fields
    - Emphasize classification metadata
      (used for embedding generation)
    - Valid, formatted JSON only
      (no comments or extra text)
    - Escape all inner double quotes as \"
    - Use fully qualified names in examples
  end note
  :Include practical "how to use it" examples;
  note right
    For ready-to-use components (CLI, Maven plugin, ...):
    - Installation instructions
    - Configuration (files, options, env vars)
    - How to run / invoke in real scenarios
    - Step-by-step explanations
  end note
  :Save JSON to bindex.json;
  :Report bindex.json creation status;

  if (bindex.json exists?) then (yes)
    :Validate bindex.json via get_bindex\n(file://bindex.json);
    while (Validation errors?) is (yes)
      :Fix bindex.json;
      :Validate bindex.json again;
    endwhile (no)
  else (no)
    :Skip registration because bindex.json\nwas not found;
    stop
  endif
}

partition "bindex/java/mvn-project Episode 3: Registration" {
  :Call register_bindex on bindex.json;
  while (Registration errors?) is (yes)
    :Fix bindex.json;
    :Call register_bindex on bindex.json again;
  endwhile (no)
  :Display returned Bindex ID\nand status message;
}

stop

@enduml
