' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists, update it to accurately reflect the current architecture, key components, and their relationships.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems: `mongodb`, `genaiProvider`, `fileSystem`; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Bindex Core - C4 Component Diagram

Person(user, "Developer / Build Process", "Uses the Bindex tools to register metadata and find libraries")
System_Ext(fileSystem, "Working Directory", "Provides bindex.json files for file-based registration")
System_Ext(genaiProvider, "GenAI Provider", "Classifies requirements and creates embedding vectors")
System_Ext(mongodb, "MongoDB", "Stores Bindex documents and classification embeddings")

System_Boundary(bindexCore, "Bindex Core") {
  Component(bindexFunctionTools, "BindexFunctionTools", "Java", "AI tool set for Bindex retrieval, recommendation, and registration")
  Component(graphqlJsonFilter, "GraphqlJsonFilter", "Java", "Projects top-level Bindex JSON fields requested by a GraphQL selection")
  Component(picker, "Picker", "Java", "Classifies requests, creates embeddings, and coordinates registration and recommendations")
  Component(repositoryInterface, "BindexRepository", "Java interface", "Defines Bindex lookup, persistence, and semantic-search operations")
  Component(mongoRepository, "MongoBindexRepository", "Java / MongoDB Driver", "Persists Bindex documents and executes filtered vector searches")
}

Rel(user, bindexFunctionTools, "Invokes")
Rel(bindexFunctionTools, fileSystem, "Reads bindex.json from")
Rel(bindexFunctionTools, graphqlJsonFilter, "Filters get results with")
Rel(bindexFunctionTools, picker, "Delegates registration and recommendations to")
Rel(bindexFunctionTools, repositoryInterface, "Retrieves Bindex records through")
Rel(bindexFunctionTools, mongoRepository, "Creates when a repository is needed")
Rel(picker, genaiProvider, "Requests classification and embeddings from")
Rel(picker, repositoryInterface, "Saves and searches Bindex records through")
Rel(mongoRepository, repositoryInterface, "Implements")
Rel(mongoRepository, mongodb, "Stores records and runs vector search in")

SHOW_LEGEND()
@enduml
