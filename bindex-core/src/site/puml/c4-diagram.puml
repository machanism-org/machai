' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists, update it to accurately reflect the current architecture, key components, and their relationships.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems: `mongodb`, `genaiProvider`, `fileSystem`; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Bindex Core - C4 Component Diagram

Person(user, "Developer / Build Process", "Uses Bindex AI tools to retrieve, recommend, and register library metadata")
System_Ext(fileSystem, "Working Directory", "Provides local bindex.json descriptors")
System_Ext(genaiProvider, "GenAI Provider", "Generates request classifications and embedding vectors")
System_Ext(mongodb, "MongoDB", "Stores Bindex documents and classification embeddings")

System_Boundary(bindexCore, "Bindex Core") {
  Component(bindexFunctionTools, "BindexFunctionTools", "Java", "Exposes tools for Bindex retrieval, library recommendations, descriptor registration, and schema access")
  Component(graphqlJsonFilter, "GraphqlJsonFilter", "Java", "Projects selected top-level fields from serialized Bindex metadata")
  Component(picker, "Picker", "Java", "Builds classifications and embeddings, then coordinates registration and semantic recommendations")
  Component(repository, "BindexRepository", "Java interface", "Defines Bindex lookup, persistence, and semantic-search operations")
  Component(mongoRepository, "MongoBindexRepository", "Java / MongoDB Driver", "Persists Bindex documents and classification embeddings and executes vector searches")
}

Rel(user, bindexFunctionTools, "Invokes AI tools")
Rel(bindexFunctionTools, fileSystem, "Reads local descriptors from")
Rel(bindexFunctionTools, graphqlJsonFilter, "Filters retrieved metadata with")
Rel(bindexFunctionTools, picker, "Delegates registration and recommendations to")
Rel(bindexFunctionTools, repository, "Retrieves Bindex records through")
Rel(bindexFunctionTools, mongoRepository, "Initializes the repository implementation")
Rel(picker, genaiProvider, "Requests classifications and embedding vectors from")
Rel(picker, repository, "Saves, retrieves, and semantically searches Bindex records through")
Rel(mongoRepository, repository, "Implements")
Rel(mongoRepository, mongodb, "Stores documents and executes vector searches in")

SHOW_LEGEND()
@enduml
