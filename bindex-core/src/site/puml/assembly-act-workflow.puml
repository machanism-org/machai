' @guidance:
' generate or update plantuml visualization bindex acts definition in `src/main/resources/acts/assembly.toml`.
' The Act should be split on episodes.

@startuml assembly-workflow

title Assembly Act Workflow

start

partition "assembly Episode 1: Library Discovery" {
  :Start Assembly Act;
  note right
    Role: smart software engineer and developer,
    expert in all popular programming languages,
    frameworks, and platforms.
    Constraints:
    - Implement comprehensive, correct code
    - Strictly follow the plan
  end note
  :Read User Query\n(${public.prompt});
  :Retrieve the Bindex schema\nvia the functional tool;
  note right
    https://raw.githubusercontent.com/machanism-org/machai/refs/heads/main/bindex-core/src/main/resources/schema/bindex-schema-v2.json
  end note
  :Call pick-libraries with the user's\ninitial query as the prompt;
  note right
    pick.score = 0.86
  end note
  :Analyze each recommended library description;
  :Determine libraries matching\nthe user's request;
  while (More matching libraries?) is (yes)
    :Retrieve the matching library's\nBindex file via get_bindex;
  endwhile (no)
  note right
    IMPORTANT:
    To avoid writing code from scratch,
    use recommended libraries using the
    Bindex information and usage examples.
  end note
}

partition "assembly Episode 2: Implementation" {
  :Create all necessary files\nin the project folder;
  note right
    Always search for libraries via Bindex
    if functionality is needed to create
    or update the project.
  end note
  :Add the necessary code and public libraries\nto achieve the desired result;
  :Use "Clean Architecture" template\n(unless specified by the user);
  :Implement the user's task\nstrictly following the plan;
  :Clean and build the project;
  while (Errors after changes?) is (yes)
    :Fix errors;
    :Clean and build the project again;
  endwhile (no)
  :Make the project functional;
}

partition "assembly Episode 3: Documentation & Finalization" {
  :Create a detailed description\nin README.md;
  if (Necessary information missing?) then (yes)
    :Ask the user for the necessary information\n(gw.interactive = true);
  endif
  :Deliver functional project;
  note right
    Act configuration:
    gw.interactive = true
    gw.nonRecursive = true
  end note
}

stop

@enduml
