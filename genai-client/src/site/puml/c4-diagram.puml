' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml GenAIClient_Component_Diagram
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title GenAI Client - C4 Component Diagram

Person(app, "Host Application", "Creates providers, submits prompts, registers tools, and requests embeddings.")

System_Ext(openaiApi, "OpenAI-compatible API", "Responses, models, embeddings, web search, and MCP-capable endpoints.")
System_Ext(anthropicApi, "Anthropic API", "Claude beta messages, web search, and MCP server integration.")
System_Ext(codeMieAuth, "CodeMie OIDC Token Endpoint", "Issues OAuth 2.0 access tokens for CodeMie-backed requests.")
System_Ext(codeMieApi, "CodeMie Code Assistant API", "OpenAI- or Anthropic-compatible GenAI gateway.")
System_Ext(mcpServers, "MCP Servers", "Optional external Model Context Protocol servers.")

Container_Boundary(genaiClient, "GenAI Client Library") {
    Component(providerManager, "GenaiProviderManager", "Java utility", "Parses provider:model identifiers and reflectively creates initialized provider implementations.")
    Component(genaiContract, "Genai", "Java interface", "Public contract for initialization, instructions, prompts, execution, tool registration, and provider state.")
    Component(embeddingContract, "EmbeddingProvider", "Java interface", "Contract for providers that generate embeddings.")
    Component(adapter, "GenaiAdapter", "Java adapter", "Delegates the Genai contract to a selected provider and supports provider decoration or switching.")
    Component(baseProvider, "AbstractAIProvider", "Java abstract class", "Shared configuration, logging, tool discovery/invocation, MCP and web-search setup, project context, and error handling.")
    Component(openAIProvider, "OpenAIProvider", "Java component", "Integrates OpenAI Responses, function tools, web search, MCP tools, embeddings, and usage capture.")
    Component(anthropicProvider, "AnthropicProvider", "Java component", "Integrates Claude Messages, tool-use loops, web search, MCP servers, prompt caching, and usage capture.")
    Component(codeMieProvider, "CodeMieProvider", "Java component", "Obtains CodeMie tokens and delegates requests to an OpenAI- or Anthropic-compatible backend selected by model prefix.")
    Component(toolsProvider, "ToolsProvider", "Java component", "Executes registered local tools when a YAML prompt describes a tool call.")
    Component(noneProvider, "NoneProvider", "Java component", "No-op Genai implementation for disabled processing, testing, or safe defaults.")
    Component(toolsLoader, "FunctionToolsLoader", "Java component", "Discovers FunctionTools implementations with ServiceLoader and applies their annotated capabilities.")
    Component(toolsModel, "FunctionTools and annotations", "Java model", "Defines tool, prompt, resource, role, parameter, and supported-application metadata plus executable callbacks.")
    Component(typeConverter, "TypeConverter", "Java utility", "Maps Java parameter types to provider schemas and converts JSON arguments to Java values.")
    Component(usage, "Usage", "Java model", "Represents token counts for a single provider response.")
    Component(usageStats, "UsageStatistics", "Java utility", "Aggregates and logs usage records by model and exposes defensive query copies.")
}

Rel(app, providerManager, "Requests an initialized provider", "Provider:Model")
Rel(app, genaiContract, "Uses", "prompt / perform")
Rel(app, embeddingContract, "Requests embeddings")
Rel(app, toolsLoader, "Loads host tools", "ServiceLoader")

Rel(providerManager, genaiContract, "Creates")
Rel(providerManager, embeddingContract, "Creates when supported")
Rel(providerManager, openAIProvider, "Instantiates")
Rel(providerManager, anthropicProvider, "Instantiates")
Rel(providerManager, codeMieProvider, "Instantiates")
Rel(providerManager, toolsProvider, "Instantiates")
Rel(providerManager, noneProvider, "Instantiates")

Rel(adapter, genaiContract, "Implements and delegates to")
Rel(codeMieProvider, adapter, "Extends")
Rel(baseProvider, genaiContract, "Implements")
Rel(openAIProvider, baseProvider, "Extends")
Rel(anthropicProvider, baseProvider, "Extends")
Rel(toolsProvider, baseProvider, "Extends")
Rel(noneProvider, genaiContract, "Implements")
Rel(openAIProvider, embeddingContract, "Implements")
Rel(codeMieProvider, embeddingContract, "Implements")

Rel(toolsLoader, toolsModel, "Discovers and applies")
Rel(toolsLoader, genaiContract, "Registers tools, prompts, and resources")
Rel(baseProvider, toolsModel, "Scans annotations and invokes callbacks")
Rel(baseProvider, typeConverter, "Builds schemas and converts arguments")
Rel(openAIProvider, usage, "Creates response usage records")
Rel(anthropicProvider, usage, "Creates response usage records")
Rel(usageStats, usage, "Stores and aggregates")

Rel(openAIProvider, openaiApi, "Calls responses, tools, models, and embeddings", "OpenAI SDK")
Rel(anthropicProvider, anthropicApi, "Calls messages and resolves tool-use loops", "Anthropic SDK")
Rel(codeMieProvider, codeMieAuth, "Obtains an access token", "HTTPS / OAuth 2.0")
Rel(codeMieProvider, codeMieApi, "Delegates compatible GenAI requests", "HTTPS")
Rel(openAIProvider, mcpServers, "Registers configured MCP tools")
Rel(anthropicProvider, mcpServers, "Forwards configured MCP definitions")

SHOW_LEGEND()
@enduml
