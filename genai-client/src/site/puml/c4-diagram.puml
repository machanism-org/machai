' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml GenAIClient_Component_Diagram
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title Machai GenAI Client - C4 Component Diagram

Person(hostApplication, "Host Application", "Selects a provider, sends prompts, and registers local capabilities.")

System_Ext(openaiApi, "OpenAI-compatible API", "Responses, embeddings, built-in web search, and MCP tools.")
System_Ext(anthropicApi, "Anthropic API", "Beta Messages API with tool use, web search, and MCP support.")
System_Ext(codeMieAuth, "CodeMie OIDC Token Endpoint", "Issues OAuth 2.0 access tokens.")
System_Ext(codeMieApi, "CodeMie Code Assistant API", "OpenAI- and Anthropic-compatible GenAI gateway.")
System_Ext(mcpServers, "MCP Servers", "Optional Model Context Protocol servers.")

Container_Boundary(genaiClient, "Machai GenAI Client Library") {
    Component(providerManager, "GenaiProviderManager", "Java utility", "Parses Provider:Model values, reflectively creates a provider, and initializes it.")
    Component(genai, "Genai", "Java interface", "Public contract for prompts, execution, instructions, project context, and tool registration.")
    Component(embeddingProvider, "EmbeddingProvider", "Java interface", "Contract for embedding-vector generation.")

    Component(adapter, "GenaiAdapter", "Java adapter", "Delegates the Genai contract to a configured provider.")
    Component(baseProvider, "AbstractAIProvider", "Java abstract class", "Shared configuration, local-tool discovery and invocation, MCP/web-search setup, and error handling.")
    Component(openaiProvider, "OpenAIProvider", "Java component", "Executes Responses API requests, local tool loops, and embeddings.")
    Component(anthropicProvider, "AnthropicProvider", "Java component", "Executes Messages API requests and local tool-use loops.")
    Component(codeMieProvider, "CodeMieProvider", "Java component", "Obtains CodeMie tokens and delegates by model prefix to an OpenAI- or Anthropic-compatible provider.")
    Component(toolsProvider, "ToolsProvider", "Java component", "Executes a registered local tool described by a YAML prompt.")
    Component(noneProvider, "NoneProvider", "Java component", "Safe no-op implementation for disabled processing or tests.")

    Component(toolsLoader, "FunctionToolsLoader", "Java component", "Uses ServiceLoader to discover compatible host FunctionTools and register their capabilities.")
    Component(toolMetadata, "FunctionTools and annotations", "Java model", "Declares executable local tools, prompts, resources, parameters, and application support.")
    Component(typeConverter, "TypeConverter", "Java utility", "Builds provider parameter schemas and converts JSON arguments to Java values.")
    Component(toolLogger, "ToolLogger", "Java utility", "Logs local tool, prompt, and resource callback activity.")
    Component(usageStatistics, "Usage and UsageStatistics", "Java model / utility", "Captures and aggregates provider token usage by model.")
}

Rel(hostApplication, providerManager, "Requests initialized provider", "Provider:Model")
Rel(hostApplication, genai, "Sends prompts and executes")
Rel(hostApplication, embeddingProvider, "Requests embeddings")
Rel(hostApplication, toolsLoader, "Loads local capabilities")

Rel(providerManager, openaiProvider, "Reflectively instantiates")
Rel(providerManager, anthropicProvider, "Reflectively instantiates")
Rel(providerManager, codeMieProvider, "Reflectively instantiates")
Rel(providerManager, toolsProvider, "Reflectively instantiates")
Rel(providerManager, noneProvider, "Reflectively instantiates")
Rel(providerManager, genai, "Returns")
Rel(providerManager, embeddingProvider, "Returns when supported")

Rel(adapter, genai, "Implements")
Rel(codeMieProvider, adapter, "Extends")
Rel(baseProvider, genai, "Implements")
Rel(openaiProvider, baseProvider, "Extends")
Rel(anthropicProvider, baseProvider, "Extends")
Rel(toolsProvider, baseProvider, "Extends")
Rel(noneProvider, genai, "Implements")
Rel(openaiProvider, embeddingProvider, "Implements")
Rel(codeMieProvider, embeddingProvider, "Implements")

Rel(toolsLoader, toolMetadata, "Discovers", "ServiceLoader")
Rel(toolsLoader, genai, "Registers tools, prompts, and resources")
Rel(baseProvider, toolMetadata, "Scans and invokes callbacks")
Rel(baseProvider, typeConverter, "Builds schemas and converts arguments")
Rel(baseProvider, toolLogger, "Logs callback activity")

Rel(openaiProvider, usageStatistics, "Records token usage")
Rel(anthropicProvider, usageStatistics, "Records token usage")
Rel(openaiProvider, openaiApi, "Calls Responses and Embeddings APIs", "OpenAI SDK")
Rel(anthropicProvider, anthropicApi, "Calls Beta Messages API", "Anthropic SDK")
Rel(codeMieProvider, codeMieAuth, "Obtains access token", "HTTPS / OAuth 2.0")
Rel(codeMieProvider, codeMieApi, "Configures delegated compatible client", "HTTPS")
Rel(openaiProvider, mcpServers, "Registers configured MCP tools")
Rel(anthropicProvider, mcpServers, "Forwards configured MCP definitions")

SHOW_LEGEND()
@enduml
