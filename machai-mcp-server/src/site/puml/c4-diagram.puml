' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Machai MCP Server - C4 Component Diagram

Person(client, "MCP Client", "IDE, AI assistant, or another process using the MCP server")
System_Ext(cliRuntime, "CLI Runtime", "Provides startup arguments and the process lifecycle")
System_Ext(projectWorkspace, "Project Workspace", "Project directory used by tool and resource functions")
System_Ext(configuration, "MCP Configuration", "Optional mcp.properties or explicitly selected configuration")
System_Ext(functionTools, "Function Tools", "Tool and prompt implementations discovered by FunctionToolsLoader")
System_Ext(mcpSdk, "MCP Java SDK", "MCP server builders, schemas, capabilities, and transport providers")
System_Ext(jetty, "Jetty HTTP Server", "Embedded servlet container for HTTP transports")

System_Boundary(machaiServer, "Machai MCP Server") {
  Component(entryPoint, "McpServer", "Application entry point", "Parses command-line options, resolves the project directory and configuration, selects the server mode, and starts it")
  Component(serverBase, "AbstractMcpServer", "Server base class", "Provides the shared project-directory context and tool registration lifecycle")
  Component(httpBase, "AbstractHttpMcpServer", "HTTP server base class", "Configures Jetty, its connector and servlet context, then starts and joins the HTTP server")

  Component(stdioServer, "StdioMcpServer", "STDIO server", "Configures single-session MCP capabilities and registers STDIO tools and prompts")
  Component(statelessServer, "HttpStatelessMcpServer", "Stateless HTTP server", "Configures stateless MCP tools, prompts and resources for HTTP requests")
  Component(streamableServer, "HttpStreamableMcpServer", "Streamable HTTP server", "Configures session-aware streamable MCP tools and prompts for HTTP requests")

  Component(toolAdapter, "GenericGenaiAdapter", "Generic tool adapter", "Builds MCP tool schemas and call handlers, invokes functions, and converts results or errors to MCP responses")
  Component(stdioAdapter, "StdioGenaiAdapter", "STDIO prompt adapter", "Converts prompt functions into STDIO MCP prompt specifications and messages")
  Component(statelessAdapter, "HttpStatelessGenericGenaiAdapter", "Stateless HTTP adapter", "Converts prompt and resource functions into stateless HTTP MCP specifications")
  Component(streamableAdapter, "HttpStreamableGenericGenaiAdapter", "Streamable HTTP adapter", "Converts prompt functions into session-aware streamable HTTP specifications")
}

Rel(client, entryPoint, "Starts or connects to", "CLI, STDIO or HTTP")
Rel(cliRuntime, entryPoint, "Supplies command-line options")
Rel(entryPoint, serverBase, "Creates and configures")
Rel(entryPoint, stdioServer, "Selects when no --port is supplied")
Rel(entryPoint, statelessServer, "Selects with --port")
Rel(entryPoint, streamableServer, "Selects with --port and --session")
Rel(entryPoint, configuration, "Loads")

Rel(stdioServer, serverBase, "Extends")
Rel(httpBase, serverBase, "Extends")
Rel(statelessServer, httpBase, "Extends")
Rel(streamableServer, httpBase, "Extends")

Rel(stdioServer, stdioAdapter, "Registers tools and prompts through")
Rel(statelessServer, statelessAdapter, "Registers tools, prompts and resources through")
Rel(streamableServer, streamableAdapter, "Registers tools and prompts through")
Rel(stdioAdapter, toolAdapter, "Reuses tool schema and execution logic")
Rel(statelessAdapter, toolAdapter, "Reuses tool schema and execution logic")
Rel(streamableAdapter, toolAdapter, "Reuses tool schema and execution logic")

Rel(stdioServer, functionTools, "Loads function tools through")
Rel(statelessServer, functionTools, "Loads function tools through")
Rel(streamableServer, functionTools, "Loads function tools through")
Rel(toolAdapter, functionTools, "Invokes discovered ToolFunction implementations")
Rel(toolAdapter, projectWorkspace, "Passes project directory to functions")
Rel(statelessAdapter, projectWorkspace, "Uses project directory for resources")
Rel(httpBase, jetty, "Starts embedded HTTP runtime with")

Rel(stdioServer, mcpSdk, "Builds MCP server and STDIO transport with")
Rel(statelessServer, mcpSdk, "Builds MCP server and stateless transport with")
Rel(streamableServer, mcpSdk, "Builds MCP server and streamable transport with")
Rel(stdioAdapter, mcpSdk, "Creates tool and prompt specifications using")
Rel(statelessAdapter, mcpSdk, "Creates tool, prompt and resource specifications using")
Rel(streamableAdapter, mcpSdk, "Creates tool and prompt specifications using")

Rel(stdioServer, client, "Exchanges MCP messages with", "stdin/stdout")
Rel(statelessServer, client, "Serves MCP requests for", "HTTP")
Rel(streamableServer, client, "Serves MCP requests for", "streamable HTTP")

SHOW_LEGEND()
@enduml
