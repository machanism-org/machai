' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Machai MCP Server — C4 Component Diagram

Person(mcpClient, "MCP Client", "IDE, AI assistant, or other MCP consumer")
System_Ext(cliRuntime, "CLI Runtime", "Launches the server and supplies command-line options")
System_Ext(configuration, "Configuration", "mcp.properties or a file selected with --config")
System_Ext(projectWorkspace, "Project Workspace", "Optional directory supplied with --projectDir")
System_Ext(functionTools, "Machai Tool Framework", "FunctionToolsLoader discovers enabled ToolFunction implementations and invokes them")
System_Ext(mcpSdk, "MCP Java SDK", "MCP server builders, schemas, and transport providers")
System_Ext(jetty, "Jetty", "Embedded HTTP servlet container")

System_Boundary(machaiServer, "Machai MCP Server") {
  Component(entryPoint, "McpServer", "Java application entry point", "Parses CLI options, loads configuration, selects a transport, configures the server, and starts it")
  Component(serverBase, "AbstractMcpServer", "Server base class", "Stores the project directory, reads enabledTools, and defines tool registration and startup hooks")
  Component(httpBase, "AbstractHttpMcpServer", "HTTP server base class", "Stores the port and transport servlet, configures Jetty, and mounts the servlet")

  Component(stdioServer, "StdioMcpServer", "STDIO transport server", "Builds a single-session MCP server and registers tools and prompts")
  Component(statelessServer, "HttpStatelessMcpServer", "Stateless HTTP transport server", "Builds a stateless MCP server and registers tools, prompts, and resources")
  Component(streamableServer, "HttpStreamableMcpServer", "Streamable HTTP transport server", "Builds a session-aware MCP server and registers tools and prompts")

  Component(genericAdapter, "GenericGenaiAdapter", "Tool adapter base", "Converts tool metadata into MCP schemas and handlers; executes tools and maps results or errors")
  Component(promptAdapter, "AbstractPromptGenaiAdapter", "Prompt adapter base", "Extends the tool adapter with MCP prompt schemas, handlers, and role-aware results")
  Component(stdioAdapter, "StdioGenaiAdapter", "STDIO adapter", "Provides STDIO tool and prompt specifications")
  Component(statelessAdapter, "HttpStatelessGenericGenaiAdapter", "Stateless HTTP adapter", "Provides stateless tool, prompt, and resource specifications")
  Component(streamableAdapter, "HttpStreamableGenericGenaiAdapter", "Streamable HTTP adapter", "Provides streamable tool and prompt specifications")
}

Rel(cliRuntime, entryPoint, "Launches and supplies options")
Rel(entryPoint, configuration, "Loads")
Rel(entryPoint, serverBase, "Sets project directory and passes configuration")
Rel(entryPoint, stdioServer, "Selects when --port is absent")
Rel(entryPoint, statelessServer, "Selects with --port without --session")
Rel(entryPoint, streamableServer, "Selects with --port --session")

Rel(stdioServer, serverBase, "Extends")
Rel(httpBase, serverBase, "Extends")
Rel(statelessServer, httpBase, "Extends")
Rel(streamableServer, httpBase, "Extends")

Rel(stdioServer, stdioAdapter, "Creates and registers")
Rel(statelessServer, statelessAdapter, "Creates and registers")
Rel(streamableServer, streamableAdapter, "Creates and registers")
Rel(promptAdapter, genericAdapter, "Extends")
Rel(stdioAdapter, promptAdapter, "Extends")
Rel(statelessAdapter, promptAdapter, "Extends")
Rel(streamableAdapter, promptAdapter, "Extends")

Rel(stdioServer, functionTools, "Uses to load enabled functions")
Rel(statelessServer, functionTools, "Uses to load enabled functions")
Rel(streamableServer, functionTools, "Uses to load enabled functions")
Rel(functionTools, stdioAdapter, "Applies enabled functions to")
Rel(functionTools, statelessAdapter, "Applies enabled functions to")
Rel(functionTools, streamableAdapter, "Applies enabled functions to")
Rel(genericAdapter, functionTools, "Invokes tool functions from")
Rel(promptAdapter, functionTools, "Invokes prompt functions from")
Rel(genericAdapter, projectWorkspace, "Supplies directory to functions")
Rel(promptAdapter, projectWorkspace, "Supplies directory to functions")
Rel(statelessAdapter, projectWorkspace, "Supplies directory to resource functions")

Rel(stdioServer, mcpSdk, "Builds server and STDIO transport with")
Rel(statelessServer, mcpSdk, "Builds server and stateless HTTP transport with")
Rel(streamableServer, mcpSdk, "Builds server and streamable HTTP transport with")
Rel(genericAdapter, mcpSdk, "Creates tool schemas and specifications with")
Rel(promptAdapter, mcpSdk, "Creates prompt schemas and specifications with")
Rel(statelessAdapter, mcpSdk, "Creates resource specifications with")
Rel(httpBase, jetty, "Starts and configures")

Rel(mcpClient, stdioServer, "Exchanges MCP messages", "stdin/stdout")
Rel(mcpClient, statelessServer, "Calls MCP endpoints", "HTTP")
Rel(mcpClient, streamableServer, "Calls MCP endpoints", "streamable HTTP")

SHOW_LEGEND()
@enduml
