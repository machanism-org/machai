' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Machai MCP Server - C4 Component Diagram

Person(client, "MCP Client", "IDE, AI assistant, or another process that invokes MCP tools, prompts, and resources")
System_Ext(cliRuntime, "CLI Runtime", "Launches the process and supplies command-line options")
System_Ext(projectWorkspace, "Project Workspace", "Project directory passed to tool and resource functions")
System_Ext(configuration, "MCP Configuration", "Optional mcp.properties file or explicitly selected configuration")
System_Ext(functionTools, "Function Tools", "FunctionToolsLoader discovers project/tool implementations from the MCP server class")
System_Ext(mcpSdk, "MCP Java SDK", "Server builders, schemas, capabilities, and STDIO/HTTP transport providers")
System_Ext(jetty, "Jetty HTTP Server", "Embedded servlet container used for HTTP transports")

System_Boundary(machaiServer, "Machai MCP Server") {
  Component(entryPoint, "McpServer", "Application entry point", "Parses command-line options, resolves configuration and project directory, selects the transport mode, and starts the server")
  Component(serverBase, "AbstractMcpServer", "Server base class", "Defines the common project-directory context and tool-registration/startup lifecycle")
  Component(httpBase, "AbstractHttpMcpServer", "HTTP server base class", "Configures Jetty, its connector and servlet context, then starts and joins the HTTP server")

  Component(stdioServer, "StdioMcpServer", "STDIO server", "Builds a single-session MCP server, registers tools and prompts, and communicates through standard input/output")
  Component(statelessServer, "HttpStatelessMcpServer", "Stateless HTTP server", "Builds a stateless MCP server and registers tools, prompts, and resources for HTTP requests")
  Component(streamableServer, "HttpStreamableMcpServer", "Streamable HTTP server", "Builds a session-aware streamable MCP server and registers tools and prompts")

  Component(toolAdapter, "GenericGenaiAdapter", "Generic tool adapter", "Creates MCP tool schemas and call handlers, invokes ToolFunction implementations, and converts results or failures to MCP responses")
  Component(stdioAdapter, "StdioGenaiAdapter", "STDIO prompt adapter", "Converts prompt functions into single-session MCP prompt specifications and messages")
  Component(statelessAdapter, "HttpStatelessGenericGenaiAdapter", "Stateless HTTP adapter", "Converts prompt and resource functions into stateless HTTP specifications")
  Component(streamableAdapter, "HttpStreamableGenericGenaiAdapter", "Streamable HTTP adapter", "Converts prompt functions into session-aware streamable HTTP specifications")
}

Rel(cliRuntime, entryPoint, "Launches and supplies options")
Rel(client, entryPoint, "Starts or connects to", "CLI, STDIO or HTTP")
Rel(entryPoint, configuration, "Loads optional")
Rel(entryPoint, serverBase, "Creates the selected server")
Rel(entryPoint, stdioServer, "Selects when --port is absent")
Rel(entryPoint, statelessServer, "Selects with --port")
Rel(entryPoint, streamableServer, "Selects with --port and --session")

Rel(stdioServer, serverBase, "Uses common lifecycle")
Rel(httpBase, serverBase, "Uses common context and lifecycle")
Rel(statelessServer, httpBase, "Extends")
Rel(streamableServer, httpBase, "Extends")

Rel(stdioServer, stdioAdapter, "Creates and registers")
Rel(statelessServer, statelessAdapter, "Creates and registers")
Rel(streamableServer, streamableAdapter, "Creates and registers")
Rel(stdioAdapter, toolAdapter, "Extends generic tool execution")
Rel(statelessAdapter, toolAdapter, "Extends generic tool execution")
Rel(streamableAdapter, toolAdapter, "Extends generic tool execution")

Rel(stdioServer, functionTools, "Loads functions through")
Rel(statelessServer, functionTools, "Loads functions through")
Rel(streamableServer, functionTools, "Loads functions through")
Rel(toolAdapter, functionTools, "Executes discovered tools")
Rel(toolAdapter, projectWorkspace, "Provides project directory to functions")
Rel(statelessAdapter, projectWorkspace, "Uses project directory for resources")

Rel(stdioServer, mcpSdk, "Builds MCP server and STDIO transport with")
Rel(statelessServer, mcpSdk, "Builds MCP server and stateless transport with")
Rel(streamableServer, mcpSdk, "Builds MCP server and streamable transport with")
Rel(stdioAdapter, mcpSdk, "Builds tool and prompt specifications with")
Rel(statelessAdapter, mcpSdk, "Builds tool, prompt, and resource specifications with")
Rel(streamableAdapter, mcpSdk, "Builds tool and prompt specifications with")
Rel(httpBase, jetty, "Starts embedded HTTP runtime with")

Rel(stdioServer, client, "Exchanges MCP messages with", "stdin/stdout")
Rel(statelessServer, client, "Serves MCP requests for", "HTTP")
Rel(streamableServer, client, "Serves MCP requests for", "streamable HTTP")

SHOW_LEGEND()
@enduml
