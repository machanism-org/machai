' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml gw-maven-plugin-components
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title gw-maven-plugin - C4 Component Diagram

Person(developer, "Developer", "Invokes Maven goals and supplies act or guidance input.")

System_Ext(maven, "Apache Maven", "Executes goals and provides project, session, settings, and reactor context.")
System_Ext(maven_settings, "Maven Settings", "Provides provider credentials and custom configuration from settings.xml.")
System_Ext(prompter, "Maven Prompter", "Collects interactive act input when no act prompt is configured.")
System_Ext(ai_provider, "AI Provider", "External GenAI service used by the GuidanceProcessor and ActProcessor.")
System_Ext(project_files, "Project Files", "Source, test, documentation, configuration, and act-definition files scanned or updated by the plugin.")

Container_Boundary(plugin, "gw-maven-plugin") {
    Component(abstract_mojo, "AbstractGWMojo", "Shared Maven Mojo", "Resolves Maven parameters, settings credentials, configuration files, excludes, instructions, scan paths, and usage logging for concrete goals.")
    Component(gw_mojo, "GWMojo", "Aggregator goal: gw", "Creates a GuidanceProcessor and coordinates guidance scanning across the execution root and Maven modules, including parallel processing.")
    Component(act_mojo, "ActMojo", "Aggregator goal: act", "Creates an ActProcessor, resolves an act prompt or definition, and coordinates act execution, including interactive input and parallel processing.")
    Component(gw_per_module_mojo, "GWPerModuleMojo", "Per-module goal", "Runs guidance processing for the current module in Maven reactor dependency order.")
    Component(act_per_module_mojo, "ActPerModuleMojo", "Per-module goal", "Runs act processing for eligible reactor modules and forces module-scoped scanning.")
    Component(class_tools, "ClassFunctionalTools", "AI function-tool adapter", "Exposes class discovery and class-metadata functions to AI workflows and maintains metadata holders per Maven project.")
    Component(class_info_holder, "ClassInfoHolder", "Class metadata index", "Lazily builds a project class loader and indexes visible classes, source paths, class paths, and dependency coordinates.")
}

Container_Boundary(ghostwriter, "Machai Ghostwriter / Processor Libraries") {
    Component(guidance_processor, "GuidanceProcessor", "Document processor", "Finds guidance comments, resolves project layout, and applies AI-assisted file changes.")
    Component(act_processor, "ActProcessor", "Document processor", "Resolves act configuration and prompts, then applies an act to selected documents.")
    Component(project_layout_manager, "ProjectLayoutManager", "Layout detection", "Detects the Maven or generic project layout used by processors.")
    Component(project_layout, "ProjectLayout / MavenProjectLayout", "Project layout", "Provides project and module metadata for document processing.")
    Component(configurator, "PropertiesConfigurator", "Configuration", "Combines provider settings, Maven server values, configuration files, and plugin parameters.")
    Component(usage_stats, "UsageStatistics", "Telemetry utility", "Initializes and records workflow usage statistics.")
}

Rel(developer, maven, "Invokes", "mvn gw:gw / gw:act")
Rel(maven, gw_mojo, "Executes and injects context")
Rel(maven, act_mojo, "Executes and injects context")
Rel(maven, gw_per_module_mojo, "Executes per-module goal")
Rel(maven, act_per_module_mojo, "Executes per-module goal")
Rel(maven_settings, abstract_mojo, "Supplies server credentials")
Rel(act_mojo, prompter, "Requests act input when needed")
Rel(abstract_mojo, configurator, "Builds effective configuration")

Rel(gw_mojo, abstract_mojo, "Extends")
Rel(act_mojo, abstract_mojo, "Extends")
Rel(gw_per_module_mojo, abstract_mojo, "Extends")
Rel(act_per_module_mojo, act_mojo, "Extends")
Rel(gw_mojo, guidance_processor, "Creates and configures")
Rel(act_mojo, act_processor, "Creates and configures")
Rel(gw_per_module_mojo, guidance_processor, "Creates and configures")
Rel(act_per_module_mojo, act_processor, "Creates and configures")
Rel(gw_mojo, class_tools, "Registers after scanning Maven projects")
Rel(act_mojo, class_tools, "Registers for project scanning")
Rel(gw_per_module_mojo, class_tools, "Registers for module scanning")
Rel(act_per_module_mojo, class_tools, "Registers for module scanning")
Rel(guidance_processor, project_layout_manager, "Detects layout")
Rel(act_processor, project_layout_manager, "Detects layout")
Rel(project_layout_manager, project_layout, "Creates")
Rel(guidance_processor, configurator, "Uses configuration")
Rel(act_processor, configurator, "Uses configuration")
Rel(guidance_processor, project_files, "Scans and updates")
Rel(act_processor, project_files, "Scans and updates")
Rel(guidance_processor, ai_provider, "Requests AI processing")
Rel(act_processor, ai_provider, "Requests AI processing")
Rel(class_tools, class_info_holder, "Indexes project classes")
Rel(class_info_holder, project_files, "Inspects compiled and source classes")
Rel(gw_mojo, usage_stats, "Initializes and logs")
Rel(act_mojo, usage_stats, "Initializes and logs")

SHOW_LEGEND()
@enduml
