' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml gw-maven-plugin-components
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title gw-maven-plugin - C4 Component Diagram

Person(developer, "Developer", "Runs Maven goals and provides guidance comments or act prompts.")

System_Ext(maven, "Apache Maven", "Executes plugin goals, injects project/session/settings context, and supplies user properties.")
System_Ext(maven_settings, "Maven Settings", "Provides server credentials and custom provider configuration from settings.xml.")
System_Ext(ai_provider, "AI Provider", "External GenAI service used by Ghostwriter processors through the MachAI AI provider layer.")
System_Ext(project_files, "Project Files", "Source, test, documentation, and configuration files scanned for guidance comments or act execution.")

Container_Boundary(plugin, "gw-maven-plugin") {
    Component(abstract_mojo, "AbstractGWMojo", "Base Maven Mojo", "Resolves shared Maven parameters, credentials, processor configuration, scan paths, excludes, instructions, usage logging, and common tool registration.")
    Component(gw_mojo, "GWMojo", "Maven goal: gw", "Scans files for @guidance comments and delegates AI-assisted guidance processing.")
    Component(act_mojo, "ActMojo", "Maven goal: act", "Runs a predefined or interactive Ghostwriter act against selected project files.")
    Component(gw_per_module_mojo, "GWPerModuleMojo", "Maven goal variant", "Executes guidance processing with per-module Maven behavior.")
    Component(act_per_module_mojo, "ActPerModuleMojo", "Maven goal variant", "Executes act processing with per-module Maven behavior.")
    Component(class_tools, "ClassFunctionalTools", "Project introspection tool", "Scans Maven project classes and exposes class-related helper functions to processors.")
}

Container_Boundary(ghostwriter, "MachAI Ghostwriter / Processor Libraries") {
    Component(guidance_processor, "GuidanceProcessor", "Processor", "Scans documents, interprets guidance comments, and applies AI-assisted file changes.")
    Component(act_processor, "ActProcessor", "Processor", "Resolves project layout, act configuration, and act prompts before processing documents.")
    Component(configurator, "PropertiesConfigurator", "Configuration", "Stores effective provider, credentials, and workflow properties.")
    Component(project_layout, "ProjectLayout / MavenProjectLayout", "Project layout", "Discovers Maven module metadata and project structure for processors.")
    Component(usage_stats, "UsageStatistics", "Telemetry utility", "Initializes and records workflow usage statistics.")
}

Rel(developer, maven, "Runs", "mvn gw:gw / mvn gw:act")
Rel(maven, gw_mojo, "Invokes goal and injects Maven context")
Rel(maven, act_mojo, "Invokes goal and injects Maven context")
Rel(maven, gw_per_module_mojo, "Invokes per-module guidance goal")
Rel(maven, act_per_module_mojo, "Invokes per-module act goal")
Rel(abstract_mojo, maven_settings, "Reads credentials and custom configuration")
Rel(abstract_mojo, configurator, "Builds effective configuration")
Rel(abstract_mojo, class_tools, "Registers when Maven project is present")

Rel(gw_mojo, abstract_mojo, "Extends shared behavior")
Rel(act_mojo, abstract_mojo, "Extends shared behavior")
Rel(gw_per_module_mojo, gw_mojo, "Specializes")
Rel(act_per_module_mojo, act_mojo, "Specializes")

Rel(gw_mojo, guidance_processor, "Creates and configures")
Rel(act_mojo, act_processor, "Creates, configures, and supplies prompt input")
Rel(guidance_processor, project_layout, "Discovers project layout")
Rel(act_processor, project_layout, "Discovers project layout")
Rel(guidance_processor, project_files, "Scans and updates")
Rel(act_processor, project_files, "Scans and updates")
Rel(guidance_processor, ai_provider, "Requests AI-assisted processing")
Rel(act_processor, ai_provider, "Requests AI-assisted act execution")
Rel(class_tools, project_files, "Inspects compiled/source classes")
Rel(gw_mojo, usage_stats, "Initializes and logs usage")
Rel(act_mojo, usage_stats, "Initializes and logs usage")

SHOW_LEGEND()
@enduml
